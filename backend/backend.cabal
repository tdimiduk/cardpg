name: backend
version: 0.1
cabal-version: >= 2.0
build-type: Simple

library
  hs-source-dirs: src
  if impl(ghcjs)
    buildable: False
  build-depends:
      base
    , common
    , frontend
    , obelisk-backend
    , obelisk-route
    , obelisk-executable-config-lookup
    , cassava
    , directory
    , gargoyle-postgresql-connect
    , resource-pool
    , postgresql-simple
    , time
    , beam-automigrate
    , beam-core
    , beam-postgres
    , text
    , aeson
    , process
    , filepath
    , either
  default-extensions:
    ConstraintKinds
    DataKinds
    DeriveGeneric
    DerivingStrategies
    DeriveAnyClass
    FlexibleContexts
    FlexibleInstances
    GADTs
    GeneralizedNewtypeDeriving
    ImportQualifiedPost
    LambdaCase
    MultiParamTypeClasses
    MultiWayIf
    OverloadedStrings
    PatternSynonyms
    QuantifiedConstraints
    RankNTypes
    RecursiveDo
    ScopedTypeVariables
    StandaloneDeriving
    TemplateHaskell
    TupleSections
    TypeApplications
    TypeFamilies
  exposed-modules:
    Backend
    Backend.Database.Migrate
    Backend.Database.Schema
    Backend.Database.Types
    Backend.GSheets.Fetch
  ghc-options: -Wall -O -fno-show-valid-hole-fits
               -- unsafe code
               -Wincomplete-record-updates -Wincomplete-uni-patterns -Wpartial-fields
               -- unneeded code
               -Widentities -Wredundant-constraints
  if impl(ghc >= 8.8)
    ghc-options:
               -Wmissing-deriving-strategies
data-files:
  generated_nix_config/python_script_path.txt

executable backend
  main-is: main.hs
  hs-source-dirs: src-bin
  ghc-options: -Wall -O -fno-show-valid-hole-fits -threaded
               -- unsafe code
               -Wincomplete-record-updates -Wincomplete-uni-patterns -Wpartial-fields
               -- unneeded code
               -Widentities -Wredundant-constraints
  if impl(ghc >= 8.8)
    ghc-options:
               -Wmissing-deriving-strategies
  if impl(ghcjs)
    buildable: False
  build-depends: base
               , backend
               , common
               , frontend
               , obelisk-backend
