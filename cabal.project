packages:
  core/core.cabal
  server/server.cabal
  api/api.cabal
  client/client.cabal
  reflex-atomic-css/reflex-atomic-css.cabal
  tools-hs/tools-hs.cabal
source-repository-package
  type: git
  location: https://github.com/reflex-frp/reflex-gadt-api.git
  tag: 45dcf247ba90490bd1d88c7a714a156e2051f109

source-repository-package
  type: git
  location: https://github.com/obsidiansystems/beam-automigrate.git
  tag: 3933b82b8affc1192638ab84fd3844991195b9cc

source-repository-package
  type: git
  location: https://github.com/reflex-frp/reflex-dom.git
  tag: 97f08ae82335b9645ffd9ca89bf1187033265a9f
  subdir: reflex-dom reflex-dom-core

source-repository-package
  type: git
  location: https://github.com/ghcjs/jsaddle.git
  tag: 0fb7260ad02592546c9f180078d770256fb1f0f6
  subdir: jsaddle jsaddle-warp jsaddle-wkwebview jsaddle-clib


allow-newer: beam-automigrate:QuickCheck, beam-automigrate:aeson, beam-automigrate:bytestring, beam-automigrate:postgresql-simple, beam-automigrate:text, beam-automigrate:vector, gargoyle-postgresql-nix:base, gargoyle-postgresql-connect:base, gargoyle:base


constraints: entropy >= 0.4.1.11, reflex-dom -webkit2gtk +use-warp

-- Enable parallel package builds
jobs: $ncpus

package *
  -- Enable parallel module compilation and optimize GC for many cores
  ghc-options: -j +RTS -A128m -n4m -RTS

package core
  ghc-options: -fwrite-ide-info

package server
  ghc-options: -fwrite-ide-info

package api
  ghc-options: -fwrite-ide-info

package client
  ghc-options: -fwrite-ide-info

package reflex-atomic-css
  ghc-options: -fwrite-ide-info
