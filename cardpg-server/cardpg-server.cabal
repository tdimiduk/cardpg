name:                cardpg-server
version:             0.1.0.0
license:             BSD3
license-file:        LICENSE
author:              Antigravity
maintainer:          antigravity@example.com
build-type:          Simple
cabal-version:       >=1.10

library
  exposed-modules:
    CardPG.Server.Types
    CardPG.Server.Engine
  hs-source-dirs:      src
  build-depends:       base >= 4.7 && < 5
                     , websockets
                     , text
                     , aeson
                     , aeson-typescript
                     , stm
                     , containers
                     , uuid
                     , cardpg-core
                     , random
  default-language:    Haskell2010

executable cardpg-server
  main-is:             Main.hs
  other-modules:       
  hs-source-dirs:      app
  build-depends:       base >= 4.7 && < 5
                     , cardpg-server
                     , websockets
                     , text
                     , aeson
                     , stm
                     , containers
                     , uuid
                     , cardpg-core
                     , bytestring
  default-extensions:  DuplicateRecordFields
                     , OverloadedStrings
  default-language:    Haskell2010

test-suite cardpg-server-test
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  other-modules:       EngineTest
  hs-source-dirs:      test
  build-depends:       base >= 4.7 && < 5
                     , cardpg-server
                     , cardpg-core
                     , tasty
                     , tasty-hunit
                     , tasty-quickcheck
                     , random
                     , containers
                     , text
  default-extensions:  DuplicateRecordFields
                     , OverloadedStrings
  default-language:    Haskell2010

