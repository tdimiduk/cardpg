cabal-version: 3.0
name:                cardpg-server
version:             0.1.0.0
license:             BSD-3-Clause
license-file:        LICENSE
author:              Antigravity
maintainer:          antigravity@example.com
build-type:          Simple

common project-config
  default-language: GHC2021
  default-extensions:
    -- Project Standard
    DerivingStrategies
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    QuantifiedConstraints
    RecordWildCards
    TemplateHaskell

    -- Control Flow
    MultiWayIf

library
  import: project-config
  exposed-modules:
    CardPG.Server.Types
    CardPG.Server.Game
    CardPG.Server.Scenario
  hs-source-dirs:      src
  build-depends:       base >= 4.7 && < 5
                     , websockets
                     , text
                     , aeson
                     , aeson-typescript
                     , stm
                     , containers
                     , uuid
                     , cardpg-core
                     , random
                     , optics
                     , mtl
                     , yaml
                     , filepath

executable cardpg-server
  import: project-config
  main-is:             Main.hs
  other-modules:       
  hs-source-dirs:      app
  build-depends:       base >= 4.7 && < 5
                     , cardpg-server
                     , websockets
                     , text
                     , aeson
                     , stm
                     , containers
                     , uuid
                     , cardpg-core
                     , bytestring
                     , random

test-suite cardpg-server-test
  import: project-config
  type:                exitcode-stdio-1.0
  main-is:             Main.hs
  other-modules:       GameTest
                     , ScenarioTest
  hs-source-dirs:      test
  build-depends:       base >= 4.7 && < 5
                     , cardpg-server
                     , cardpg-core
                     , tasty
                     , tasty-hunit
                     , tasty-quickcheck
                     , random
                     , containers
                     , text
                     , directory
                     , optics
                     , mtl
                     , yaml
                     , filepath
