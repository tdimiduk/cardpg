name:                cardpg-server
version:             0.1.0.0
license:             BSD3
license-file:        LICENSE
author:              Antigravity
maintainer:          antigravity@example.com
build-type:          Simple
cabal-version:       >=1.10

executable cardpg-server
  main-is:             Main.hs
  hs-source-dirs:      src
  build-depends:       base >= 4.7 && < 5
                     , websockets
                     , text
                     , aeson
                     , stm
                     , containers
                     , uuid
                     , bytestring
  default-extensions:  DuplicateRecordFields
                     , OverloadedStrings
  default-language:    Haskell2010
