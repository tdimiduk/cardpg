cabal-version: 3.4
name:          client-reflex
version:       0.1.0.0
synopsis:      Reflex-DOM frontend for CardPG
license:       MIT
author:        Antigravity
maintainer:    antigravity@example.com
build-type:    Simple

common project-config
  default-language:   GHC2021
  ghc-options:        -Wall
  default-extensions:
    DefaultSignatures
    DerivingStrategies
    DuplicateRecordFields
    LambdaCase
    MultiWayIf
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    QuantifiedConstraints
    RecordWildCards
    RecursiveDo
    TemplateHaskell
    TypeFamilies

library
  import:          project-config
  build-depends:
    , aeson
    , api
    , base
    , bytestring
    , containers
    , core
    , data-default
    , dependent-sum
    , foreign-store
    , http-types
    , jsaddle-warp
    , optics
    , optics-core
    , random
    , reflex
    , reflex-dom
    , reflex-dom-core
    , reflex-gadt-api
    , text
    , uuid
    , vector
    , wai
    , wai-app-static
    , warp
    , websockets
    , yaml

  -- cabal-fmt: expand src
  exposed-modules:
    Frontend.App
    Frontend.Card
    Frontend.Catalog
    Frontend.Devel
    Frontend.Game.ActorDetails
    Frontend.Game.ActorDetails.Assets
    Frontend.Game.ActorDetails.Consequences
    Frontend.Game.ActorDetails.Deck
    Frontend.Game.ActorDetails.DeckViewer
    Frontend.Game.ActorDetails.Stats
    Frontend.Game.ActorLogic
    Frontend.Game.Common
    Frontend.Game.Hand
    Frontend.Game.PlannedAction
    Frontend.Game.Planning
    Frontend.Game.Sidebar
    Frontend.Game.SidebarRight
    Frontend.Game.Staging
    Frontend.Html
    Frontend.Icons
    Frontend.Style
    Frontend.Svg
    Frontend.Svg.Path
    Frontend.UI.Button
    Frontend.UI.Scaler
    Frontend.Util

  hs-source-dirs:  src

executable client-reflex
  import:         project-config
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N -main-is ClientMain
  main-is:        Main.hs
  build-depends:
    , base
    , client-reflex

  hs-source-dirs: app

executable cardpg-static
  import:         project-config
  main-is:        StaticMain.hs
  hs-source-dirs: app
  build-depends:
    , api
    , base
    , bytestring
    , client-reflex
    , containers
    , core
    , directory
    , filepath
    , mtl
    , optparse-applicative
    , process
    , random
    , reflex-dom-core
    , server
    , text
    , uuid
    , yaml

test-suite client-reflex-test
  import:         project-config
  type:           exitcode-stdio-1.0
  main-is:        Main.hs
  hs-source-dirs: tests
  other-modules:  PlanningTest
  build-depends:
    , base
    , client-reflex
    , containers
    , core
    , mtl
    , reflex
    , reflex-dom-core
    , reflex-test-host
    , tasty
    , tasty-hunit
    , text
    , uuid
