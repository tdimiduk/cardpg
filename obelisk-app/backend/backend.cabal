name: backend
version: 0.1
cabal-version: >= 2.0
build-type: Simple

library
  hs-source-dirs: src
  if impl(ghcjs)
    buildable: False
  build-depends: base
               , aeson
               , beam-automigrate
               , beam-core
               , beam-postgres
               , bytestring
               , cassava
               , common
               , cardpg-core
               , directory
               , either
               , filepath
               , frontend
               , gargoyle-postgresql-connect
               , generic-lens
               , lens
               , obelisk-backend
               , obelisk-executable-config-lookup
               , obelisk-route
               , postgresql-simple
               , process
               , reflex-gadt-api
               , resource-pool
               , snap-core
               , text
               , time
               , typed-process
               , vector
               , websockets
               , websockets-snap
  default-extensions:
    ConstraintKinds
    DataKinds
    DeriveAnyClass
    DeriveGeneric
    DerivingStrategies
    DuplicateRecordFields
    FlexibleContexts
    FlexibleInstances
    GADTs
    GeneralizedNewtypeDeriving
    ImportQualifiedPost
    LambdaCase
    MultiParamTypeClasses
    MultiWayIf
    OverloadedLabels
    OverloadedLabels
    OverloadedStrings
    PatternSynonyms
    QuantifiedConstraints
    RankNTypes
    RecursiveDo
    ScopedTypeVariables
    StandaloneDeriving
    TemplateHaskell
    TupleSections
    TypeApplications
    TypeFamilies
  exposed-modules:
    Backend
    Backend.Api
    Backend.Common
    Backend.Database.Migrate
    Backend.Database.Schema
    Backend.Database.Types
    Backend.Database.Write
    Backend.GSheets.Fetch
  ghc-options: -Wall -O -fno-show-valid-hole-fits
               -- unsafe code
               -Wincomplete-record-updates -Wincomplete-uni-patterns -Wpartial-fields
               -- unneeded code
               -Widentities -Wredundant-constraints
  if impl(ghc >= 8.8)
    ghc-options:
               -Wmissing-deriving-strategies
executable backend
  main-is: main.hs
  hs-source-dirs: src-bin
  ghc-options: -Wall -O -fno-show-valid-hole-fits -threaded
               -- unsafe code
               -Wincomplete-record-updates -Wincomplete-uni-patterns -Wpartial-fields
               -- unneeded code
               -Widentities -Wredundant-constraints
  if impl(ghc >= 8.8)
    ghc-options:
               -Wmissing-deriving-strategies
  if impl(ghcjs)
    buildable: False
  build-depends: base
               , backend
               , common
               , frontend
               , obelisk-backend
