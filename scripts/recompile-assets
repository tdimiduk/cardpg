#!/usr/bin/env bash
set -e

# Run gen-css binary passed as first arg (optional)
if [ -n "$1" ] && [ -f "$1" ]; then
  echo "Running CSS generator..."
  "$1"
fi

# Get workspace root directory
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# 1. Generate Haskell keyword glossary and export JSON
echo "Generating Haskell keyword glossary and JSON export..."
cabal run tools-hs:exe:keyword-mod -- codegen --fix
cabal run tools-hs:exe:keyword-mod -- export-glossary --output "$ROOT_DIR/export/glossary.json"

# 2. Compile Markdown to Pandoc AST JSON with native wikilinks flag
echo "Compiling markdown rules to Pandoc AST JSON..."
pandoc "$ROOT_DIR/design/rules/core-rules.md" \
  -f markdown+wikilinks_title_after_pipe -t json -o "$ROOT_DIR/client/static/rules.json"
pandoc "$ROOT_DIR/design/rules/keyword-glossary.md" \
  -f markdown+wikilinks_title_after_pipe -t json -o "$ROOT_DIR/client/static/glossary-ast.json"
pandoc "$ROOT_DIR/design/rules/colors-of-action.md" \
  -f markdown+wikilinks_title_after_pipe -t json -o "$ROOT_DIR/client/static/colors.json"

# 3. Generate static HTML via cardpg-static
echo "Generating Reflex-native static rules HTML..."
cabal run client:exe:cardpg-static -- rules --output-dir "$ROOT_DIR/client/static" --no-snapshot

echo "Asset recompilation complete."
