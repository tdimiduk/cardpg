#!/usr/bin/env nix-shell
#!nix-shell -i python3 -p python3
import os
import sys
import subprocess
import hashlib
from concurrent.futures import ThreadPoolExecutor

# Target directories containing Haskell code
DIRS = ["api", "client", "core", "server", "tools", "tools-hs", "reflex-atomic-css"]
MAX_ITERATIONS = 3

def get_git_diff_hash(files=None):
    """Returns a SHA-256 hash of the current git diff compared to HEAD.
    If files is provided, only hashes the diff for those files.
    """
    try:
        cmd = ["git", "diff", "HEAD"]
        if files:
            cmd.extend(["--"] + files)
        res = subprocess.run(cmd, capture_output=True, text=True, check=True)
        return hashlib.sha256(res.stdout.encode('utf-8')).hexdigest()
    except subprocess.CalledProcessError:
        return ""

def find_hs_files():
    """Finds all Haskell source files under target directories, ignoring build artifacts."""
    hs_files = []
    for d in DIRS:
        if not os.path.exists(d):
            continue
        for root, dirs, files in os.walk(d):
            # Prune .direnv and dist-newstyle directories
            dirs[:] = [name for name in dirs if name not in (".direnv", "dist-newstyle")]
            for file in files:
                if file.endswith(".hs"):
                    hs_files.append(os.path.join(root, file))
    return hs_files

def find_cabal_files():
    """Finds all cabal files up to 2 levels deep under target directories."""
    cabal_files = []
    for d in DIRS:
        if not os.path.exists(d):
            continue
        for root, dirs, files in os.walk(d):
            # Limit search depth to maxdepth 2
            depth = root.count(os.sep) - d.count(os.sep)
            if depth >= 2:
                dirs[:] = []  # Don't recurse deeper
                continue
            for file in files:
                if file.endswith(".cabal"):
                    cabal_files.append(os.path.join(root, file))
    return cabal_files

def get_changed_files():
    """Returns a list of all changed files (staged, unstaged, untracked) that exist on disk."""
    changed = set()
    # 1. Unstaged changes
    res = subprocess.run(["git", "diff", "--name-only"], capture_output=True, text=True)
    if res.returncode == 0:
        changed.update(res.stdout.splitlines())
    # 2. Staged changes
    res = subprocess.run(["git", "diff", "--cached", "--name-only"], capture_output=True, text=True)
    if res.returncode == 0:
        changed.update(res.stdout.splitlines())
    # 3. Untracked files
    res = subprocess.run(["git", "ls-files", "--others", "--exclude-standard"], capture_output=True, text=True)
    if res.returncode == 0:
        changed.update(res.stdout.splitlines())
        
    return [f for f in sorted(changed) if os.path.exists(f)]

def get_target_files(run_all=False):
    """Returns (hs_files, cabal_files) to run tidy on."""
    if run_all:
        return find_hs_files(), find_cabal_files()
        
    changed = get_changed_files()
    hs_files = []
    cabal_files = []
    
    for f in changed:
        parts = f.split(os.sep)
        if not parts or parts[0] not in DIRS:
            continue
        if f.endswith(".hs"):
            hs_files.append(f)
        elif f.endswith(".cabal"):
            cabal_files.append(f)
            
    return hs_files, cabal_files

def run_hlint_refactor(file):
    """Runs hlint refactoring in-place on a single file."""
    subprocess.run(
        ["hlint", "--refactor", "--refactor-options=-i", file],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL
    )

def main():
    # Parse arguments
    args = sys.argv[1:]
    run_all = "--all" in args or "-a" in args

    if run_all:
        print("=== Starting Tidy / Prep-Commit Workflow (All Files) ===")
    else:
        print("=== Starting Tidy / Prep-Commit Workflow (Changed Files Only) ===")

    # Get files to process
    hs_files, cabal_files = get_target_files(run_all)
    
    if not hs_files and not cabal_files:
        print("No files to tidy.")
        return

    # Track only the files we are modifying in the git diff hash
    modified_files_list = hs_files + cabal_files

    iteration = 1
    changed = True

    while iteration <= MAX_ITERATIONS and changed:
        print(f"Iteration {iteration} of {MAX_ITERATIONS}...")
        
        pre_hash = get_git_diff_hash(modified_files_list)
        
        # 1. Run HLint refactorings in parallel
        if hs_files:
            print(f"  Applying HLint refactorings in-place on {len(hs_files)} files...")
            with ThreadPoolExecutor() as executor:
                executor.map(run_hlint_refactor, hs_files)
            
        # 2. Format Haskell files with fourmolu in chunks
        if hs_files:
            print(f"  Formatting {len(hs_files)} Haskell files with fourmolu...")
            chunk_size = 50
            for i in range(0, len(hs_files), chunk_size):
                chunk = hs_files[i:i + chunk_size]
                subprocess.run(
                    ["fourmolu", "--mode", "inplace"] + chunk,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                )
                
        # 3. Format cabal files
        if cabal_files:
            print(f"  Formatting {len(cabal_files)} cabal files...")
            for cfile in cabal_files:
                subprocess.run(
                    ["cabal-fmt", "--inplace", cfile],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                )

        post_hash = get_git_diff_hash(modified_files_list)
        if pre_hash == post_hash:
            changed = False
            print("  Stable state (fixed-point) reached!")
        else:
            print(f"  Changes detected in iteration {iteration}. Re-looping...")
            iteration += 1

    print("\n=== Checking Remaining HLint Hints ===")
    if hs_files:
        # Run hlint only on the target hs_files
        subprocess.run(["hlint"] + hs_files)
    else:
        print("No Haskell files to check.")

    print("\n=== Finished! ===")
    print("Please inspect git diff / magit, stage your changes, and commit.")

if __name__ == "__main__":
    main()
