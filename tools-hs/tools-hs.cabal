cabal-version: 3.0
name:          tools-hs
version:       0.1.0.0
synopsis:      Design and development tools for caRdPG
license:       BSD-3-Clause
build-type:    Simple

common project-config
  default-language:   GHC2021
  default-extensions:
    DerivingStrategies
    DuplicateRecordFields
    OverloadedRecordDot
    OverloadedStrings
    RecordWildCards

  ghc-options:        -Wall

executable audit-consequences
  import:         project-config
  hs-source-dirs: src
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , aeson
    , base        >=4.16 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , text
    , yaml
