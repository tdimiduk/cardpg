cabal-version: 3.0
name:          tools-hs
version:       0.1.0.0
synopsis:      Design and development tools for caRdPG
license:       BSD-3-Clause
build-type:    Simple

common project-config
  default-language:   GHC2021
  default-extensions:
    DerivingStrategies
    DuplicateRecordFields
    MultiWayIf
    OverloadedRecordDot
    OverloadedStrings
    RecordWildCards

  ghc-options:        -Wall

library
  import:          project-config
  hs-source-dirs:  src
  exposed-modules:
    AuditConsequences
    Design.Audit
    Design.Bundle
    Design.Frontmatter
    Design.Glossary
    Design.Index
    Design.Prettier
    Design.TOC
    Design.Types
    KeywordMod
    ManageCards
    ManageCards.Audit
    ManageCards.Classifier
    ManageCards.Deduplicate
    ManageCards.Export
    ManageCards.Rewrite
    ManageCards.Types

  build-depends:
    , aeson
    , aeson-pretty
    , base                  >=4.16 && <5
    , bytestring
    , containers
    , core
    , directory
    , filepath
    , megaparsec
    , optparse-applicative
    , process
    , text
    , time
    , vector
    , yaml

executable audit-consequences
  import:         project-config
  hs-source-dirs: app/audit-consequences
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , tools-hs

executable keyword-mod
  import:         project-config
  hs-source-dirs: app/keyword-mod
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , tools-hs

executable audit-index
  import:         project-config
  hs-source-dirs: app/audit-index
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , containers
    , directory
    , filepath
    , optparse-applicative
    , tools-hs

executable manage-cards
  import:         project-config
  hs-source-dirs: app/manage-cards
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , directory
    , filepath
    , optparse-applicative

executable bundle-topic
  import:         project-config
  hs-source-dirs: app/bundle-topic
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , directory
    , filepath
    , optparse-applicative
    , text
    , tools-hs

test-suite tools-hs-test
  import:         project-config
  type:           exitcode-stdio-1.0
  hs-source-dirs: tests
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , bytestring
    , containers
    , core
    , directory
    , filepath
    , tasty
    , tasty-hunit
    , text
    , tools-hs
    , yaml
