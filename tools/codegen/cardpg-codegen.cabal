name:                cardpg-codegen
version:             0.1.0.0
build-type:          Simple
cabal-version:       >=1.10

executable codegen
  main-is:             Main.hs
  build-depends:       base >= 4.7 && < 5
                     , aeson-typescript
                     , cardpg-core
                     , cardpg-server
                     , text
  default-language:    Haskell2010
