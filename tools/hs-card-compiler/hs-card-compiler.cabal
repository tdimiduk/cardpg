cabal-version:      3.0
name:               hs-card-compiler
version:            0.1.0.0
synopsis:           Compiles JSON card definitions to YAML using Haskell parsers
license:            BSD-3-Clause
author:             Antigravity
maintainer:         antigravity@google.com
build-type:         Simple

common warnings
    ghc-options: -Wall

executable hs-card-compiler
    import:           warnings
    main-is:          Main.hs
    other-modules:    CardCompiler.Parser
                    , CardCompiler.VttExporter
    -- other-extensions:
    build-depends:    base >= 4.16 && < 5
                    , aeson
                    , bytestring
                    , text
                    , yaml
                    , megaparsec
                    , vector
                    , cardpg-core
                    , filepath
                    , directory
                    , containers
    hs-source-dirs:   src
    default-language: Haskell2010

test-suite hs-card-compiler-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test, src
    other-modules:    CardCompiler.Parser
    build-depends:    base
                    , hspec
                    , QuickCheck
                    , hspec-megaparsec
                    , cardpg-core
                    , text
                    , aeson
                    , vector
                    , megaparsec
                    , containers
    default-language: Haskell2010
